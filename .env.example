# EmailJS (https://dashboard.emailjs.com). These are public values by design.
# Never add your EmailJS private key here.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Your personal email address, shown on the site and passed to the template as {{to_email}}
NEXT_PUBLIC_CONTACT_EMAIL=
